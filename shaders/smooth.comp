#version 450 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0, r32f) uniform image3D uSource;
layout(binding = 1, r32f) uniform image3D uDest;
uniform float uSigma;
uniform int uAxis;   // 0=X, 1=Y, 2=Z

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(uSource);
    if (any(greaterThanEqual(coord, size))) return;

    int radius = int(ceil(uSigma * 3.0));
    float sum = 0.0;
    float weightSum = 0.0;

    for (int i = -radius; i <= radius; i++) {
        ivec3 sampleCoord = coord;
        if (uAxis == 0) sampleCoord.x += i;
        else if (uAxis == 1) sampleCoord.y += i;
        else sampleCoord.z += i;

        sampleCoord = clamp(sampleCoord, ivec3(0), size - ivec3(1));

        float w = exp(-float(i*i) / (2.0 * uSigma * uSigma));
        sum += imageLoad(uSource, sampleCoord).r * w;
        weightSum += w;
    }

    imageStore(uDest, coord, vec4(sum / weightSum, 0.0, 0.0, 0.0));
}